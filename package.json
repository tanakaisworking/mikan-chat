{
  "name": "mikan-chat",
  "version": "0.1.0",
  "private": true,
  "description": "ライトユーザー向けのローカルAIキャラクターチャットシミュレーター",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "build:demo-pack": "node scripts/build-demo-pack.mjs",
    "prebuild": "npm run build:demo-pack",
    "prebuild:renderer": "npm run build:demo-pack",
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "dev:worker": "npm run build:renderer && wrangler dev",
    "build": "npm run typecheck && electron-vite build",
    "build:renderer": "vite build",
    "deploy:worker": "npm run build:renderer && wrangler deploy",
    "preview": "vite preview",
    "types:worker": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.542.0",
    "marked": "^18.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
